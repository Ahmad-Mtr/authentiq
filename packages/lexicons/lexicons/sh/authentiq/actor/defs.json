{
  "lexicon": 1,
  "id": "sh.authentiq.actor.defs",
  "defs": {
    "profileView": {
      "type": "object",
      "description": "An actor as shown in lists, search results and post bylines.",
      "required": ["did", "handle"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
        "headline": { "type": "string", "maxGraphemes": 120, "maxLength": 1200 },
        "avatar": { "type": "string", "format": "uri" },
        "location": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "openToWork": { "type": "boolean" },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    },
    "profileViewDetailed": {
      "type": "object",
      "description": "A full profile page: the profile record plus its positions and education.",
      "required": ["did", "handle"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
        "headline": { "type": "string", "maxGraphemes": 120, "maxLength": 1200 },
        "about": { "type": "string", "maxGraphemes": 2000, "maxLength": 20000 },
        "avatar": { "type": "string", "format": "uri" },
        "location": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "openToWork": { "type": "boolean" },
        "skills": {
          "type": "array",
          "maxLength": 50,
          "items": { "type": "string", "maxGraphemes": 40, "maxLength": 400 }
        },
        "positions": {
          "type": "array",
          "maxLength": 100,
          "items": { "type": "ref", "ref": "#positionView" }
        },
        "education": {
          "type": "array",
          "maxLength": 50,
          "items": { "type": "ref", "ref": "#educationView" }
        },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    },
    "positionView": {
      "type": "object",
      "required": ["uri", "title", "organization", "startDate"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "title": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "organization": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "employmentType": { "type": "string", "knownValues": ["full-time", "part-time", "contract", "internship", "freelance", "volunteer"] },
        "locationType": { "type": "string", "knownValues": ["onsite", "hybrid", "remote"] },
        "location": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "startDate": { "type": "string", "description": "Year or year-month, e.g. 2024 or 2024-06.", "maxLength": 7 },
        "endDate": { "type": "string", "description": "Absent means the actor still holds this position.", "maxLength": 7 },
        "description": { "type": "string", "maxGraphemes": 2000, "maxLength": 20000 },
        "skills": {
          "type": "array",
          "maxLength": 25,
          "items": { "type": "string", "maxGraphemes": 40, "maxLength": 400 }
        }
      }
    },
    "educationView": {
      "type": "object",
      "required": ["uri", "school"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "school": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "degree": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "fieldOfStudy": { "type": "string", "maxGraphemes": 100, "maxLength": 1000 },
        "startDate": { "type": "string", "maxLength": 7 },
        "endDate": { "type": "string", "maxLength": 7 },
        "description": { "type": "string", "maxGraphemes": 1000, "maxLength": 10000 }
      }
    }
  }
}
