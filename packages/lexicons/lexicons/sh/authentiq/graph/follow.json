{
  "lexicon": 1,
  "id": "sh.authentiq.graph.follow",
  "defs": {
    "main": {
      "type": "record",
      "description": "The author follows another account. Following yourself is not allowed. Follower counts are never shown.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": { "type": "string", "format": "did" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
