{
  "lexicon": 1,
  "id": "sh.authentiq.feed.getTimeline",
  "defs": {
    "main": {
      "type": "query",
      "description": "The signed-in account's home timeline: posts by the accounts it follows, newest first. Served by the AppView itself, not a feed generator, so it works whatever state the generators are in. Requires service auth (lxm = this NSID, aud = the AppView).",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string", "maxLength": 512 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "cursor": { "type": "string", "maxLength": 512 },
            "feed": { "type": "array", "items": { "type": "ref", "ref": "sh.authentiq.feed.defs#feedViewPost" } }
          }
        }
      }
    }
  }
}
