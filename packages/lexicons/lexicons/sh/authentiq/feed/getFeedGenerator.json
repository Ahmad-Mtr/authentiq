{
  "lexicon": 1,
  "id": "sh.authentiq.feed.getFeedGenerator",
  "defs": {
    "main": {
      "type": "query",
      "description": "One feed's declaration, as indexed. Does not contact the generator. Optional service auth (lxm = this NSID) adds whether the viewer pinned it.",
      "parameters": {
        "type": "params",
        "required": ["feed"],
        "properties": { "feed": { "type": "string", "format": "at-uri" } }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["view"],
          "properties": { "view": { "type": "ref", "ref": "sh.authentiq.feed.defs#generatorView" } }
        }
      },
      "errors": [{ "name": "UnknownFeed" }]
    }
  }
}
