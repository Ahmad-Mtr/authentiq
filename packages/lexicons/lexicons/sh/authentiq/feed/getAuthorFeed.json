{
  "lexicon": 1,
  "id": "sh.authentiq.feed.getAuthorFeed",
  "defs": {
    "main": {
      "type": "query",
      "description": "An account's posts and replies, newest first. Served by the AppView. Optional service auth (lxm = this NSID) adds viewer state.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
          "cursor": { "type": "string", "maxLength": 200 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "cursor": { "type": "string" },
            "feed": { "type": "array", "items": { "type": "ref", "ref": "sh.authentiq.feed.defs#feedViewPost" } }
          }
        }
      },
      "errors": [{ "name": "ActorNotFound" }]
    }
  }
}
