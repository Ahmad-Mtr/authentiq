{
  "lexicon": 1,
  "id": "sh.authentiq.feed.listFeedGenerators",
  "defs": {
    "main": {
      "type": "query",
      "description": "Feed discovery: every valid generator record this AppView has indexed, oldest first, from any publisher. There is no popularity ordering. Optional service auth (lxm = this NSID) adds whether the viewer pinned each one.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string", "maxLength": 512 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["feeds"],
          "properties": {
            "cursor": { "type": "string", "maxLength": 512 },
            "feeds": { "type": "array", "items": { "type": "ref", "ref": "sh.authentiq.feed.defs#generatorView" } }
          }
        }
      }
    }
  }
}
