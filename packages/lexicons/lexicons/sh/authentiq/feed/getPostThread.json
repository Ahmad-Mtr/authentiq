{
  "lexicon": 1,
  "id": "sh.authentiq.feed.getPostThread",
  "defs": {
    "main": {
      "type": "query",
      "description": "A post with its parents and replies. Served by the AppView. Relationships are resolved when this is called, so a reply indexed before its parent shows the parent once it arrives. Optional service auth (lxm = this NSID) adds viewer state.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" },
          "depth": { "type": "integer", "minimum": 0, "maximum": 20, "default": 8, "description": "Levels of replies to include." },
          "parentHeight": { "type": "integer", "minimum": 0, "maximum": 100, "default": 80, "description": "Levels of parents to include." }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["thread"],
          "properties": {
            "thread": {
              "type": "union",
              "refs": [
                "sh.authentiq.feed.defs#threadViewPost",
                "sh.authentiq.feed.defs#notFoundPost",
                "sh.authentiq.feed.defs#hiddenPost"
              ]
            }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
