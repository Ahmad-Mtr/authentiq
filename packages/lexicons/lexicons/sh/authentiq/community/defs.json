{
  "lexicon": 1,
  "id": "sh.authentiq.community.defs",
  "defs": {
    "communityView": {
      "type": "object",
      "description": "A community as the AppView shows it. No member count, for the same reason there are no follower counts.",
      "required": ["uri", "cid", "creator", "name", "topic", "createdAt", "indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "creator": { "type": "ref", "ref": "sh.authentiq.actor.defs#profileView" },
        "name": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
        "description": { "type": "string", "maxGraphemes": 1000, "maxLength": 10000 },
        "topic": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
        "rules": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "datetime" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "viewer": { "type": "ref", "ref": "#viewerState" }
      }
    },
    "communityViewBasic": {
      "type": "object",
      "required": ["uri", "name", "topic"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "name": { "type": "string" },
        "topic": { "type": "string" }
      }
    },
    "viewerState": {
      "type": "object",
      "properties": {
        "membership": { "type": "string", "format": "at-uri", "description": "The viewer's membership record, if they joined." },
        "isCreator": { "type": "boolean", "description": "The viewer created this community and can hide posts in it." }
      }
    }
  }
}
