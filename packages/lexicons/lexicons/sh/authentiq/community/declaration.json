{
  "lexicon": 1,
  "id": "sh.authentiq.community.declaration",
  "defs": {
    "main": {
      "type": "record",
      "description": "Declares a topic-scoped community. The account that writes it is the community's creator and its only moderator.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "topic", "createdAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxGraphemes": 64, "maxLength": 640 },
          "description": { "type": "string", "maxGraphemes": 1000, "maxLength": 10000 },
          "topic": {
            "type": "string",
            "description": "The one subject the community is about, e.g. 'Platform engineering'.",
            "minLength": 1,
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "rules": {
            "type": "array",
            "maxLength": 20,
            "items": { "type": "string", "maxGraphemes": 300, "maxLength": 3000 }
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
