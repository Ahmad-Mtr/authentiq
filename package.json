{
  "name": "authentiq",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "bun run infra:up && turbo dev",
    "dev:apps": "turbo dev",
    "codegen": "turbo codegen",
    "infra:env": "bun infra/scripts/gen-env.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down --volumes",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:status": "bun infra/scripts/status.ts",
    "seed": "bun infra/scripts/seed-accounts.ts",
    "db:generate": "bun --filter @workspace/db db:generate",
    "db:migrate": "bun --filter @workspace/db db:migrate",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
