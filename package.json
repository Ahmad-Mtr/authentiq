{
  "name": "authentiq",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "bun run infra:up && turbo dev",
    "dev:apps": "turbo dev",
    "codegen": "turbo codegen",
    "infra:env": "bun infra/scripts/gen-env.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down --volumes",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:status": "bun infra/scripts/status.ts",
    "seed": "bun infra/scripts/seed-accounts.ts",
    "seed:talent": "bun infra/scripts/seed-talent.ts",
    "seed:social": "bun infra/scripts/seed-social.ts",
    "seed:jobs": "bun infra/scripts/seed-jobs.ts",
    "seed:feeds": "bun infra/scripts/seed-feeds.ts && bun --cwd apps/feedgen-thirdparty publish-feed",
    "seed:demo": "bun infra/scripts/seed-demo.ts",
    "verify:lexicons": "bun infra/scripts/verify-lexicons.ts",
    "verify:oauth": "bun infra/scripts/verify-oauth.ts",
    "verify:indexer": "bun infra/scripts/verify-indexer.ts",
    "verify:resume": "bun infra/scripts/verify-resume.ts",
    "eval:resume": "bun infra/scripts/eval-resume.ts",
    "fixtures:resumes": "bun infra/scripts/gen-resume-fixtures.ts",
    "fixtures:demo": "bun infra/scripts/gen-demo-data.ts",
    "verify:search": "bun infra/scripts/verify-search.ts",
    "verify:agent": "bun infra/scripts/verify-agent.ts",
    "verify:social": "bun infra/scripts/verify-social.ts",
    "verify:jobs": "bun infra/scripts/verify-jobs.ts",
    "verify:feeds": "bun infra/scripts/verify-feeds.ts",
    "eval:search": "bun infra/scripts/eval-search.ts",
    "eval:agent": "bun infra/scripts/eval-agent.ts",
    "eval:bias": "bun infra/scripts/eval-bias.ts",
    "verify:all": "bun infra/scripts/verify-all.ts",
    "demo:portability": "bun infra/scripts/demo-portability.ts",
    "demo:replay": "bun infra/scripts/demo-replay.ts",
    "db:generate": "bun --filter @workspace/db db:generate",
    "db:migrate": "bun --filter @workspace/db db:migrate && bun infra/scripts/db-roles.ts",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.44",
    "@atproto/crypto": "^0.5.5",
    "@atproto/repo": "^0.10.14",
    "@workspace/ai": "workspace:*",
    "@workspace/atproto": "workspace:*",
    "@workspace/lexicons": "workspace:*",
    "@workspace/rules": "workspace:*",
    "docx": "^9.8.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
