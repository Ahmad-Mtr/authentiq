PORT=2584
DATABASE_URL=postgres://authentiq:__POSTGRES_PASSWORD__@localhost:__POSTGRES_PORT__/authentiq
PDS_URL=http://localhost:2583
PLC_URL=http://localhost:2582
WEB_ORIGIN=http://localhost:3000
# did:web identity; service auth tokens for resume upload are addressed to it.
SERVICE_DID=did:web:localhost%3A2584
# Fetch guard dev override (phase 8): host:port entries that may be fetched over
# http and resolve to loopback. Empty in a deployment. PLC and PDS are added automatically.
FETCH_ALLOW=localhost:2585-2586,localhost:2590-2594
# Bearer token for /_admin/* (indexer stop/start/backfill); unset disables them.
# bun run verify:indexer reads it from this file.
ADMIN_TOKEN=__ADMIN_TOKEN__
# Mistral: resume parsing (phase 4), embeddings and the recruiting agent (phase 5).
MISTRAL_API_KEY=
